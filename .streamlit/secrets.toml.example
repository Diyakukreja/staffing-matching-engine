# Copy into Streamlit Community Cloud -> App settings -> Secrets (never commit the real file).
# Postgres connection string from Neon / Supabase / any managed Postgres. Required for durable assignments.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Show full phone numbers in the UI. Keep "false" for any public or demo deployment.
SHOW_PHONES = "false"
